/*
  程序功能：使用 GPIO 48 驱动无源蜂鸣器，播放《两只老虎》歌曲。
  使用方法：把无源蜂鸣器驱动输入连接 GPIO 48，上传程序后直接运行。
  运行结果：无源蜂鸣器按照音符频率和节拍播放《两只老虎》。
  产品声明：本程序为青潮智科产品配套示例程序。
*/

// 无源蜂鸣器连接 GPIO 48，通过不同频率发出不同音高
#define PIN_BUZZER 48

// 《两只老虎》使用的音符频率，单位是 Hz
const int melody[] = {
  262, 294, 330, 262,
  262, 294, 330, 262,
  330, 349, 392,
  330, 349, 392,
  392, 440, 392, 349, 330, 262,
  392, 440, 392, 349, 330, 262,
  262, 196, 262,
  262, 196, 262
};

// 每个音符持续的时间，单位是毫秒
const int noteTime[] = {
  400, 400, 400, 400,
  400, 400, 400, 400,
  400, 400, 800,
  400, 400, 800,
  200, 200, 200, 200, 400, 400,
  200, 200, 200, 200, 400, 400,
  400, 400, 800,
  400, 400, 800
};

// 数组中的音符数量
const int NOTE_COUNT = sizeof(melody) / sizeof(melody[0]);

void setup() {
  pinMode(PIN_BUZZER, OUTPUT);
}

void loop() {
  // 按顺序播放数组中的每一个音符
  for (int i = 0; i < NOTE_COUNT; i = i + 1) {
    tone(PIN_BUZZER, melody[i], noteTime[i]);

    // 多等待一小会儿，让相邻音符能够分开
    delay(noteTime[i] + 60);
    noTone(PIN_BUZZER);
  }

  // 一遍歌曲播放完毕后停顿 2 秒
  delay(2000);
}
