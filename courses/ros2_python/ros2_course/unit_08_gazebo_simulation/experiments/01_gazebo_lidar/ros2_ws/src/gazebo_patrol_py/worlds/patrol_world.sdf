<?xml version="1.0"?>
<sdf version="1.9">
  <world name="patrol_world">
    <!-- Gazebo 系统负责物理、运行时命令、场景发布和传感器更新。 -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 四面墙构成简单巡检场地。 -->
    <model name="walls">
      <static>true</static>
      <link name="walls_link">
        <collision name="north_collision"><pose>0 3 0.5 0 0 0</pose><geometry><box><size>6 0.1 1</size></box></geometry></collision>
        <visual name="north_visual"><pose>0 3 0.5 0 0 0</pose><geometry><box><size>6 0.1 1</size></box></geometry></visual>
        <collision name="south_collision"><pose>0 -3 0.5 0 0 0</pose><geometry><box><size>6 0.1 1</size></box></geometry></collision>
        <visual name="south_visual"><pose>0 -3 0.5 0 0 0</pose><geometry><box><size>6 0.1 1</size></box></geometry></visual>
        <collision name="east_collision"><pose>3 0 0.5 0 0 0</pose><geometry><box><size>0.1 6 1</size></box></geometry></collision>
        <visual name="east_visual"><pose>3 0 0.5 0 0 0</pose><geometry><box><size>0.1 6 1</size></box></geometry></visual>
        <collision name="west_collision"><pose>-3 0 0.5 0 0 0</pose><geometry><box><size>0.1 6 1</size></box></geometry></collision>
        <visual name="west_visual"><pose>-3 0 0.5 0 0 0</pose><geometry><box><size>0.1 6 1</size></box></geometry></visual>
      </link>
    </model>

    <model name="my_robot">
      <pose>0 0 0.16 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <mass>8.0</mass>
          <inertia><ixx>0.09</ixx><iyy>0.18</iyy><izz>0.23</izz></inertia>
        </inertial>
        <collision name="base_collision"><geometry><box><size>0.5 0.34 0.12</size></box></geometry></collision>
        <visual name="base_visual">
          <geometry><box><size>0.5 0.34 0.12</size></box></geometry>
          <material><ambient>0.1 0.35 0.8 1</ambient><diffuse>0.1 0.35 0.8 1</diffuse></material>
        </visual>
      </link>

      <link name="left_wheel">
        <pose relative_to="base_link">0 0.19 -0.06 1.5708 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.001</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry></visual>
      </link>
      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>left_wheel</child>
        <!-- 关节轴在旋转后的关节/子连杆参考中沿圆柱轴 Z。 -->
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <link name="right_wheel">
        <pose relative_to="base_link">0 -0.19 -0.06 1.5708 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.001</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry></visual>
      </link>
      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>right_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <link name="caster">
        <pose relative_to="base_link">-0.18 0 -0.09 0 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.04</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.04</radius></sphere></geometry></visual>
      </link>
      <joint name="caster_joint" type="fixed"><parent>base_link</parent><child>caster</child></joint>

      <link name="laser_link">
        <pose relative_to="base_link">0.16 0 0.12 0 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.05</radius><length>0.06</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.05</radius><length>0.06</length></cylinder></geometry></visual>
        <sensor name="lidar" type="gpu_lidar">
          <topic>/scan</topic>
          <update_rate>10</update_rate>
          <lidar>
            <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
            <range><min>0.12</min><max>8.0</max><resolution>0.01</resolution></range>
          </lidar>
          <always_on>true</always_on>
          <visualize>true</visualize>
        </sensor>
      </link>
      <joint name="laser_joint" type="fixed"><parent>base_link</parent><child>laser_link</child></joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.38</wheel_separation>
        <wheel_radius>0.09</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
