<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="wheel_radius" default="0.05"/>
  <xacro:arg name="wheel_sep" default="0.32"/>
  <xacro:arg name="base_length" default="0.28"/>
  <xacro:arg name="base_width" default="0.22"/>
  <xacro:arg name="use_lidar" default="true"/>
  <xacro:property name="r" value="$(arg wheel_radius)"/>
  <xacro:property name="sep" value="$(arg wheel_sep)"/>
  <xacro:property name="a" value="$(arg base_length)"/>
  <xacro:property name="b" value="$(arg base_width)"/>
  <xacro:property name="h" value="0.04"/>
  <xacro:property name="base_z" value="0.065"/>
  <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <link name="base_footprint"/>
  <link name="base_link">
    <visual><geometry><box size="${a} ${b} ${h}"/></geometry><material name="blue"/></visual>
    <collision><geometry><box size="${a} ${b} ${h}"/></geometry></collision>
    <inertial><mass value="1.0"/><inertia ixx="${(b*b+h*h)/12}" ixy="0" ixz="0" iyy="${(a*a+h*h)/12}" iyz="0" izz="${(a*a+b*b)/12}"/></inertial>
  </link>
  <joint name="footprint_to_base" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 ${base_z}"/></joint>
  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${r}" length="0.02"/></geometry><material name="black"/></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${r}" length="0.02"/></geometry></collision>
      <inertial><origin rpy="${pi/2} 0 0"/><mass value="0.1"/><inertia ixx="${0.1*(3*r*r+0.02*0.02)/12}" ixy="0" ixz="0" iyy="${0.1*(3*r*r+0.02*0.02)/12}" iyz="0" izz="${0.1*r*r/2}"/></inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous"><parent link="base_link"/><child link="${prefix}_wheel_link"/><origin xyz="0 ${reflect*sep/2} ${r-base_z}"/><axis xyz="0 1 0"/></joint>
  </xacro:macro>
  <xacro:wheel prefix="left" reflect="1"/><xacro:wheel prefix="right" reflect="-1"/>
  <link name="caster_link">
    <visual><geometry><sphere radius="0.01"/></geometry><material name="black"/></visual>
    <collision><geometry><sphere radius="0.01"/></geometry></collision>
    <inertial><mass value="0.02"/><inertia ixx="0.0000008" ixy="0" ixz="0" iyy="0.0000008" iyz="0" izz="0.0000008"/></inertial>
  </link>
  <joint name="base_to_caster" type="fixed"><parent link="base_link"/><child link="caster_link"/><origin xyz="${a/3} 0 ${0.01-base_z}"/></joint>
  <xacro:if value="$(arg use_lidar)">
    <link name="laser_link">
      <visual><geometry><cylinder radius="0.025" length="0.03"/></geometry><material name="black"/></visual>
      <collision><geometry><cylinder radius="0.025" length="0.03"/></geometry></collision>
      <inertial><mass value="0.05"/><inertia ixx="0.00001156" ixy="0" ixz="0" iyy="0.00001156" iyz="0" izz="0.000015625"/></inertial>
    </link>
    <joint name="base_to_laser" type="fixed"><parent link="base_link"/><child link="laser_link"/><origin xyz="0.06 0 0.05"/></joint>
  </xacro:if>
  <link name="imu_link">
    <visual><geometry><box size="0.02 0.02 0.01"/></geometry><material name="blue"/></visual>
    <inertial><mass value="0.01"/><inertia ixx="0.0000004167" ixy="0" ixz="0" iyy="0.0000004167" iyz="0" izz="0.0000006667"/></inertial>
  </link>
  <joint name="base_to_imu" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.025"/></joint>
</robot>
