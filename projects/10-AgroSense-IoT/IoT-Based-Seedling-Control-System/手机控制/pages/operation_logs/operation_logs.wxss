/* operation_logs.wxss */
page {
  height: 100vh;
  background-image: url(https://imgs.699pic.com/images/600/026/512.jpg!detail.v1);
  background-size: cover;
  background-position: center;
  padding: 0;
  box-sizing: border-box;
}

/* 自定义顶部导航栏 */
.custom-header {
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: sticky;
  top: 0;
  z-index: 100;
  padding-top: 60rpx; /* 适配刘海屏 */
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.logs-container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: rgba(255, 255, 255, 0.9);
}

.logs-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1989fa;
}

.back-button {
  font-size: 28rpx;
  padding: 10rpx 20rpx;
  background-color: #f2f2f2;
}

/* 刷新按钮样式 */
.refresh-button {
  font-size: 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 20rpx;
}

/* 复制按钮样式 */
.copy-button {
  font-size: 20rpx;
  height: 50rpx;
  line-height: 50rpx;
  padding: 0 15rpx;
  margin-left: 10rpx;
  background-color: #f0f0f0;
  color: #666;
}

/* 空状态刷新按钮 */
.empty-refresh-button {
  margin-top: 30rpx;
  font-size: 24rpx;
  height: 60rpx;
  line-height: 60rpx;
}

/* 日志内容区域 */
.logs-content {
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 10rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 120rpx; /* 为底部按钮留出空间 */
}

/* 日志列表 */
.logs-list {
  max-height: calc(80vh - 100rpx);
  overflow-y: auto;
  padding-bottom: 20rpx;
}

/* 日志头部布局 */
.log-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
}

/* 垂直布局样式 */
.log-header.vertical-layout {
  flex-direction: column;
  align-items: flex-start;
}

/* 用户名样式 */
.log-user {
  font-size: 32rpx;
  font-weight: bold;
  color: #1989fa;
  margin-bottom: 8rpx;
}

/* 操作文本样式 */
.log-operation {
  font-size: 28rpx;
  line-height: 44rpx;
  color: #333;
  word-break: break-all;
  margin-bottom: 10rpx;
}

.log-header .log-text {
  flex: 1;
  margin-right: 10rpx;
}

/* 日志项 */
.log-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #eeeeee;
  margin-bottom: 10rpx;
  border-radius: 8rpx;
  background-color: rgba(255, 255, 255, 0.8);
}

.log-item:last-child {
  border-bottom: none;
}

/* 日志文本 */
.log-text {
  font-size: 28rpx;
  line-height: 44rpx;
  color: #333;
  word-break: break-all;
  white-space: pre-line;
}

/* 日志类型颜色区分 */
.log-item.success .log-text {
  color: #52c41a;
}

.log-item.error .log-text {
  color: #ff4d4f;
}

.log-item.warning .log-text {
  color: #faad14;
}

/* 日志详情样式 */
.log-detail {
  margin-top: 10rpx;
  padding: 10rpx;
  background-color: #f5f5f5;
  border-radius: 6rpx;
  font-size: 26rpx;
  color: #666;
  margin-top: 15rpx;
}

/* 日志详情信息样式 */
.log-detail-info {
  margin-top: 15rpx;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  border-left: 4rpx solid #1989fa;
}

/* 详情行样式 */
.log-detail-info view {
  display: flex;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  line-height: 38rpx;
}

.log-detail-info view:last-child {
  margin-bottom: 0;
}

/* 详情标签样式 */
.detail-label {
  font-weight: bold;
  color: #666;
  min-width: 120rpx;
}

/* 详情值样式 */
.detail-value {
  color: #333;
  flex: 1;
  word-break: break-all;
}

/* 错误文本样式 */
.error-text {
  color: #ff4d4f;
  font-weight: 500;
}

/* 无日志状态样式 */
.empty-state {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 无权限样式 */
.no-permission {
  text-align: center;
  padding: 100rpx 20rpx;
  color: #666;
  font-size: 28rpx;
}

/* 底部按钮容器样式 */
.bottom-button-container {
  position: fixed;
  bottom: 40rpx;
  left: 20rpx;
  right: 20rpx;
  display: flex;
  justify-content: center;
  z-index: 999;
}

.bottom-button-container .back-button {
  width: 80%;
  height: 80rpx;
  font-size: 32rpx;
  background-color: #1989fa;
  color: white;
  border-radius: 10rpx;
}

/* 加载更多状态样式 */
.loading-more {
  text-align: center;
  padding: 20rpx 0;
  color: #999;
  font-size: 26rpx;
  background-color: rgba(255, 255, 255, 0.8);
  margin-top: 10rpx;
  border-radius: 8rpx;
}

/* 滚动条样式 */
.logs-list::-webkit-scrollbar {
  width: 6rpx;
}

.logs-list::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 3rpx;
}

.logs-list::-webkit-scrollbar-thumb {
  background: #888;
  border-radius: 3rpx;
}

.logs-list::-webkit-scrollbar-thumb:hover {
  background: #555;
}


.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

.no-permission {
  text-align: center;
  padding: 100rpx 0;
  color: #ff6b6b;
  font-size: 32rpx;
}