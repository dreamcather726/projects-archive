<?xml version="1.0"?>
<sdf version="1.6">
  <world name="my_world">
    <gravity>0 0 -9.8</gravity>
    <physics name="ode" type="ode"><max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate></physics>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground_plane"><static>true</static><link name="ground">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></visual>
    </link></model>
    <model name="wall_1"><static>true</static><pose>1.5 0 0.5 0 0 0</pose><link name="wall">
      <collision name="collision"><geometry><box><size>0.1 3 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.1 3 1</size></box></geometry></visual>
    </link></model>
  </world>
</sdf>
