/* index.wxss */
page {
  height: 100vh;
  background-color: #f6f6f6;
  background-image: url(https://imgs.699pic.com/images/600/026/512.jpg!detail.v1);
  background-size: cover;
  background-position: center;
  padding: 0;
  box-sizing: border-box;
}

/* 自定义顶部导航栏 */
.custom-header {
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: sticky;
  top: 0;
  z-index: 100;
  padding-top: 60rpx; /* 适配刘海屏 */
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.header-actions {
  display: flex;
  align-items: center;
}

.header-icon {
  width: 48rpx;
  height: 48rpx;
  margin-left: 30rpx;
}

/* 调整容器位置以避开导航栏 */
.container {
  padding: 20rpx;
  box-sizing: border-box;
}

/* 容器样式 */
.container {
  width: 100%;
  display: flex;
  flex-direction: column;
}

/* 设备卡片样式 */
.device-section {
  width: 100%;
}

.device-card {
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(10rpx);
}

.device-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.device-title-container {
  display: flex;
  align-items: center;
}

.device-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.device-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.auto-mode-switch {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.auto-mode-switch text {
  font-size: 28rpx;
  color: #666;
  margin-right: 10rpx;
}

/* 传感器网格布局 */
.sensor-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.sensor-item {
  background-color: #fff;
  padding: 5rpx;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 48%;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  min-height: 180rpx;
}

.sensor-icon-container {
  margin-bottom: 10rpx;
}

.sensor-icon {
  width: 90rpx;
  height: 90rpx;
  margin-right: 10rpx;
}

.sensor-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.sensor-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.sensor-status {
  font-size: 28rpx;
  color: #07c160;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  background-color: #f0f9ff;
}

/* 控制部分样式 */
.control-section {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.control-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
  gap: 10rpx;
}

.control-icon-container {
  display: flex;
  align-items: center;
}

.control-icon {
  width: 50rpx;
  height: 50rpx;
  margin-bottom: 5rpx;
}

.control-item text {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

/* 设置按钮样式 */
.settings-section {
  width: 100%;
  margin: 20rpx 0;
}

.settings-button {
  background-color: #07c160;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  margin: 20rpx 0;
}

/* 状态信息样式 */
.status-info {
  text-align: center;
  padding: 20rpx 0;
}

.status-info text {
  font-size: 24rpx;
  color: #999;
}

/* 滚动区域样式 */
.scrollarea {
  flex: 1;
  overflow-y: auto;

  border-top: .5px solid rgba(0, 0, 0, 0.1);
  border-bottom: .5px solid rgba(0, 0, 0, 0.1);
  color: black;
}

.nickname-label {
  width: 105px;
}

.nickname-input {
  flex: 1;
}

/* 状态图标样式 */
.status-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 10rpx;
}

/* 控制按钮样式 */
.control-button {
  font-size: 32rpx;
  padding: 4rpx 12rpx;
  max-width: 120rpx;
  width: 120rpx;
  border-radius: 20rpx;
  background-color: #07c160;
  color: white;
  margin: 0;
  min-width: 100rpx;
  line-height: 50rpx;
}

.control-button:active {
  background-color: #06b055;
}

/* 退出按钮样式 */
.navigateToLogs-button {
  background-color: red;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  margin: 10rpx 0;
}

.navigateToLogs-button:active {
  background-color: #e53935;
}
