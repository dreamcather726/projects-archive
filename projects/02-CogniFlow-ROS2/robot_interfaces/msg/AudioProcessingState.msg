# 可视化使用的音频处理阶段，不代表机器人运动任务状态。
builtin_interfaces/Time stamp
string source_node
string boot_id
uint64 event_seq
string request_id
string session_id
string segment_id
string input_context_id
string audio_path
# 当前阶段对应的服务／Action，失败时也保留，便于界面区分失败环节。
string operation
uint8 QUEUED=0
uint8 WAITING_ASR=1
uint8 RECOGNIZING=2
uint8 WAITING_PARSE=3
uint8 PARSING=4
uint8 READY=5
uint8 NEED_CLARIFICATION=6
uint8 FAILED=7
uint8 CANCELED=8
uint8 NO_SPEECH=9
uint8 ASR_COMPLETED=10
uint8 stage
string message
string error_code
