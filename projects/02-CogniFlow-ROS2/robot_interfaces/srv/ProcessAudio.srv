# Complete input metadata plus a WAV path shared by PC interface and AI nodes.
# stamp preserves the source AudioSegment generation time.
builtin_interfaces/Time stamp
string request_id
string session_id
string segment_id
string input_context_id
builtin_interfaces/Time capture_started_at
builtin_interfaces/Time capture_ended_at
uint32 sample_rate
uint8 channels
string encoding
string audio_path
