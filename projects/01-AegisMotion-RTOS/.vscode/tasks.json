        {
            "label": "Keil: Rebuild STM32F407ZGT6",
            "type": "process",
            "command": "D:\\Application\\Keil5\\UV4\\UV4.exe",
            "args": [
                "-r",
                "${workspaceFolder}\\STM32F407ZGT6.uvprojx",
                "-t",
                "STM32F407ZGT6",
                "-o",
                "${workspaceFolder}\\rebuild.log"
            ],
            "problemMatcher": []
        },
        {
            "label": "Keil: Download STM32F407ZGT6",
