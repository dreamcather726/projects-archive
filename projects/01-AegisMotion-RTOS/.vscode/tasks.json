            "command": "D:\\Application\\Keil5\\UV4\\UV4.exe",
            "args": [
                "-f",
                "${workspaceFolder}\\STM32F407ZGT6.uvprojx",
                "-t",
                "STM32F407ZGT6"
            ],
            "problemMatcher": []
        }
    ]
